<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/step3_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_gradient"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="0dp"
    android:paddingEnd="0dp"
    tools:context=".Step3Fragment">

    <!-- Floating Bubbles -->
    <ImageView
        android:id="@+id/bubble1Step3"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:src="@drawable/bubble_background"
        android:alpha="0.6"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="50dp"
        android:layout_marginTop="100dp" />

    <ImageView
        android:id="@+id/bubble2Step3"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:src="@drawable/bubble_background"
        android:alpha="0.4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginEnd="80dp"
        android:layout_marginTop="150dp" />

    <ImageView
        android:id="@+id/bubble3Step3"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:src="@drawable/bubble_background"
        android:alpha="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginStart="120dp"
        android:layout_marginBottom="200dp" />

    <ImageView
        android:id="@+id/bubble4Step3"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:src="@drawable/bubble_background"
        android:alpha="0.3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="120dp" />

    <ImageView
        android:id="@+id/bubble5Step3"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:src="@drawable/bubble_background"
        android:alpha="0.2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="200dp"
        android:layout_marginTop="300dp" />

    <ImageView
        android:id="@+id/bubble6Step3"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:src="@drawable/bubble_background"
        android:alpha="0.4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginEnd="150dp"
        android:layout_marginTop="250dp" />

    <ImageView
        android:id="@+id/bubble7Step3"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:src="@drawable/bubble_background"
        android:alpha="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="280dp"
        android:layout_marginTop="180dp" />

    <ImageView
        android:id="@+id/bubble8Step3"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:src="@drawable/bubble_background"
        android:alpha="0.3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginEnd="200dp"
        android:layout_marginBottom="280dp" />

    <ImageView
        android:id="@+id/bubble9Step3"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:src="@drawable/bubble_background"
        android:alpha="0.6"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginStart="180dp"
        android:layout_marginBottom="150dp" />

    <ImageView
        android:id="@+id/bubble10Step3"
        android:layout_width="9dp"
        android:layout_height="9dp"
        android:src="@drawable/bubble_background"
        android:alpha="0.4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginEnd="30dp"
        android:layout_marginTop="400dp" />

    <ImageView
        android:id="@+id/bubble11Step3"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:src="@drawable/bubble_background"
        android:alpha="0.35"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginStart="70dp"
        android:layout_marginBottom="350dp" />

    <ImageView
        android:id="@+id/bubble12Step3"
        android:layout_width="9dp"
        android:layout_height="9dp"
        android:src="@drawable/bubble_background"
        android:alpha="0.55"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginEnd="60dp"
        android:layout_marginTop="50dp" />

    <ImageView
        android:id="@+id/bubble13Step3"
        android:layout_width="11dp"
        android:layout_height="11dp"
        android:src="@drawable/bubble_background"
        android:alpha="0.45"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="150dp"
        android:layout_marginTop="30dp" />

    <ImageView
        android:id="@+id/bubble14Step3"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/bubble_background"
        android:alpha="0.25"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginEnd="100dp"
        android:layout_marginBottom="80dp" />

    <ImageView
        android:id="@+id/bubble15Step3"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:src="@drawable/bubble_background"
        android:alpha="0.6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginEnd="220dp"
        android:layout_marginTop="320dp" />

    <!-- Header Başlık -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:fontFamily="@font/poppins_bold"
        android:text="CVRaterAI"
        android:textColor="#FFFFFF"
        android:textSize="36sp"
        android:textStyle="bold"
        android:elevation="16dp"
        android:shadowColor="#BB000000"
        android:shadowDx="0"
        android:shadowDy="8"
        android:shadowRadius="12"
        android:letterSpacing="0.02"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardProfile"
        android:layout_width="280dp"
        android:layout_height="330dp"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="100dp"
        android:elevation="12dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="22dp"
        app:cardElevation="10dp"
        app:cardMaxElevation="12dp"
        app:cardPreventCornerOverlap="true"
        app:cardUseCompatPadding="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/button_gradient"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="131dp"
                android:layout_height="44dp"
                android:fontFamily="@font/poppins_semibold"
                android:gravity="center"
                android:shadowColor="#40000000"
                android:shadowDx="0"
                android:shadowDy="3"
                android:shadowRadius="4"
                android:text="@string/step3_title"
                android:textColor="@color/white"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="20dp"
                android:fontFamily="@font/poppins_regular"
                android:gravity="center"
                android:text="@string/step3_description"
                android:textColor="@color/white"
                android:textSize="20sp" />

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="109dp"
                android:layout_height="95dp"
                android:layout_marginBottom="15dp"
                android:elevation="8dp"
                android:src="@drawable/analysis" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Next Button styled consistently -->
    <androidx.cardview.widget.CardView
        android:id="@+id/btnGetStarted"
        android:layout_width="194dp"
        android:layout_height="56dp"
        android:layout_marginBottom="110dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/button_gradient">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="@font/poppins_medium"
                android:text="@string/next"
                android:textColor="@color/white"
                android:textSize="18sp" />

        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="50dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_margin="6dp"
            android:background="@drawable/dot_unselected" />

        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_margin="6dp"
            android:background="@drawable/dot_unselected" />

        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_margin="6dp"
            android:background="@drawable/dot_selected" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>